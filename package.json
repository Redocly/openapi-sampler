{
  "name": "openapi-sampler",
  "version": "1.7.6",
  "description": "Tool for generation samples based on OpenAPI payload/response schema",
  "main": "dist/openapi-sampler.js",
  "module": "src/openapi-sampler.js",
  "types": "./src/types.d.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npm run lint && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "changeset": "npx @changesets/cli --",
    "release": "npm run build && npm run changeset publish"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Redocly/openapi-sampler.git"
  },
  "keywords": [
    "OpenAPI",
    "Swagger",
    "instantiator",
    "sampler",
    "faker"
  ],
  "author": "Roman Hotsiy <gotsijroman@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Redocly/openapi-sampler/issues"
  },
  "homepage": "https://github.com/Redocly/openapi-sampler/",
  "browserslist": "> 0.25%, not dead",
  "devDependencies": {
    "@babel/core": "^7.7.2",
    "@babel/preset-env": "^7.7.1",
    "@changesets/cli": "^3.0.3",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.1.0",
    "ajv-formats": "^2.0.2",
    "babel-loader": "^8.0.6",
    "core-js": "^3.4.1",
    "coveralls-next": "^6.0.2",
    "json-loader": "^0.5.7",
    "oxlint": "^1.88.0",
    "rollup": "^4.63.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.7",
    "fast-xml-parser": "^5.5.1",
    "json-pointer": "0.6.2"
  },
  "overrides": {
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "picomatch": "2.3.2"
  }
}
